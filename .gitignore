# Dependencies
node_modules/

# Build output — regenerated by `npm run build`
dist/

# Test coverage reports — regenerated by `npm run test:coverage`
coverage/

# Machine-readable test-count summaries — regenerated by `npm run test`,
# consumed by scripts/check-doc-test-counts.mjs (issue #198)
scripts/vitest-summary.json
scripts/vitest-summary-light.json
scripts/vitest-summary-heavy.json
scripts/client-logic-summary.json

# Onshape API credentials (written to ~/.stressform_onshape.json, but never commit any local copy)
.stressform_onshape.json
*.onshape.json

# External binaries (users install these per the README)
tetgen
tetgen.exe
gmsh
gmsh.exe

# Session / analysis artifacts
*.step
*.stl
session-*.zip
report-*.html

# Electron packaging output
../stressform-electron/release/
release/

# OS / editor junk
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/

# Claude Code agent worktrees — temporary isolated checkouts for background
# subagents, never part of the deliverable
.claude/
